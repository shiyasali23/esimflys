{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esimflys",

  // A ~40-line proxy, not a framework adapter. It replaced `.open-next/worker.js`, whose
  // 6.27 MB handler was evaluated on every cold isolate and produced Error 1102.
  "main": "worker/index.js",

  "compatibility_date": "2025-04-01",
  // No nodejs_compat. The old entry needed Node built-ins because it loaded the Next.js
  // server runtime; this Worker uses only fetch and URL, and dropping the flag keeps the
  // isolate as small as the code.
  "compatibility_flags": [],

  "assets": {
    // `next build` with `output: "export"` writes the whole site here — every page as a
    // prerendered .html file. Cloudflare serves these directly, so a page view costs no
    // Worker invocation at all.
    "directory": "./out",
    "binding": "ASSETS",

    // Next emits `/about.html`; visitors ask for `/about`. Auto handling resolves both
    // spellings and canonicalises with a redirect, which is what next.config.mjs's
    // `skipTrailingSlashRedirect` used to be negotiating with the Node server.
    "html_handling": "auto-trailing-slash",

    // MUST stay "none". Anything else makes the asset router answer unmatched paths
    // itself, and /api/v1/* matches no asset — the API would receive the 404 page
    // instead of reaching the Worker. The Worker serves 404.html itself; see
    // `notFound()` in worker/index.js.
    "not_found_handling": "none"
  },

  // A public hostname, not a secret. Read at REQUEST time by the Worker — unlike the
  // OpenNext setup, where it was baked into the build, so a wrong value needed a full
  // rebuild to correct. Changing the backend host is now a `wrangler deploy` away.
  //
  // This is the Railway service's own hostname, not `api.esimflys.com` — that name has
  // never had a DNS record, and the value here went unread because OpenNext used the
  // build-time variable instead. Under the proxy Worker it IS the value that gets used,
  // so a wrong one takes down every API call rather than being cosmetic.
  "vars": {
    "BACKEND_ORIGIN": "https://esimflys-production-512c.up.railway.app"
  },

  "observability": {
    "enabled": true
  },

  // Binds the production domain to this Worker. Without this, esimflys.com and
  // www resolve to Cloudflare's edge but have no Worker attached, and every
  // request either 522s (apex, no origin) or falls through to whatever legacy
  // DNS record is still present (www previously hit Railway's edge directly,
  // stripping the request path to "/").
  "routes": [
    { "pattern": "esimflys.com", "custom_domain": true },
    { "pattern": "www.esimflys.com", "custom_domain": true }
  ]
}
