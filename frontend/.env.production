# Committed, non-secret production build values. Loaded automatically by `next build`.
#
# These used to live only in Cloudflare's dashboard build settings, because the site was
# built by Cloudflare's git integration. It is now a static export built locally and
# shipped with `wrangler deploy`, so a value that exists only in a dashboard is a value
# that silently reverts to the localhost default the moment anyone builds from a laptop.
# Nothing here is a secret — every one of these is visible in the shipped HTML.
#
# Secrets (Stripe publishable key) stay in the uncommitted .env.local, which overrides
# this file.

# Canonical host. The apex, matching the `rel="canonical"` already served in production —
# both esimflys.com and www.esimflys.com answer, and this is what tells crawlers which of
# the two is the real one. Changing it without also changing the canonical redirect
# splits every page into two competing URLs.
NEXT_PUBLIC_SITE_URL=https://esimflys.com

# Deliberately NOT set here: BACKEND_ORIGIN.
#
# Under OpenNext it was baked into the rewrite destinations at build time. The static
# export has no rewrites; the proxy Worker reads it at request time from `vars` in
# wrangler.jsonc instead. Setting it here would do nothing except imply it still matters,
# and the build makes no backend request at all — catalogue and FX rates are committed
# files under src/data/.
