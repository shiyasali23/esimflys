# eSIMFlys frontend — environment (copy to .env.local). NEVER commit real secrets.

# Public site origin. Drives canonical URLs, Open Graph, the sitemap and robots.txt.
# Production: https://www.esimflys.com
# Pick ONE canonical host and 301 the other at DNS/host level — serving the site on
# both the apex and www splits every page into two competing URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend origin for the same-origin proxy in next.config.mjs. REQUIRED.
# Read at BUILD time (it is baked into the rewrite destinations) AND at runtime by
# src/server/rates.js — so it must be set in the build environment and in the deployed
# runtime environment. Leaving it unset bakes `http://localhost:8000` into the rewrites
# and every API call and login breaks in production.
# Use `localhost`, never `127.0.0.1`: allauth builds the Google redirect_uri from the
# forwarded Host, and a session cookie scoped to 127.0.0.1 never reaches the frontend.
BACKEND_ORIGIN=http://localhost:8000

# Stripe publishable key (client-safe; the SECRET key stays on the backend).
# Must be the pk_live_… key when the backend is on sk_live_… — a mismatched pair
# fails at confirmation, after the customer has already committed.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Analytics (optional, consent-gated).
# NEXT_PUBLIC_ANALYTICS_ID=

# Where `npm run catalog` reads the catalogue from. Needed ONLY when you deliberately
# refresh the catalogue — the build does not call it.
#
# `src/data/catalog.json` is a committed source file and the storefront makes no runtime
# call for catalogue data, so `next build` needs no backend at all. Refreshing prices is
# an explicit act: run `npm run catalog`, review the diff, commit it. The no-leak check
# that used to run in the build is enforced independently by src/data/catalog.data.test.js.
CATALOG_API_ORIGIN=http://localhost:8000
