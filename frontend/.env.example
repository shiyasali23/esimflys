# eSIMFlys frontend — environment (copy to .env.local). NEVER commit real secrets.

# Public site origin (used for canonical/OG/sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API (SERVER-ONLY — not NEXT_PUBLIC_). FastAPI/Django at :8000.
API_BASE_URL=http://localhost:8000

# Use catalog.json + mock BFF responses until the backend is up.
USE_MOCKS=true

# DEV ONLY: render paused plans so the store is buildable (DATA BLOCKER R13).
# MUST be false for a real launch (once the business activates plans).
SHOW_PAUSED_PLANS=true

# Stripe (publishable key is client-safe; SECRET key stays on the backend).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Analytics (optional, consent-gated).
# NEXT_PUBLIC_ANALYTICS_ID=
