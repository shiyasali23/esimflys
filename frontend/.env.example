# eSIMFlys frontend — environment (copy to .env.local). NEVER commit real secrets.

# Public site origin. Drives canonical URLs, Open Graph, the sitemap and robots.txt.
# Production: https://www.esimflys.com
# Pick ONE canonical host and 301 the other at DNS/host level — serving the site on
# both the apex and www splits every page into two competing URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend origin for the same-origin proxy in next.config.mjs. REQUIRED.
# Read at BUILD time — it is baked into the rewrite destinations — and at runtime by
# the dynamic routes (/account/*, /admin/*, /agency/*), so set it in BOTH the build
# environment and the deployed runtime. Leaving it unset bakes `http://localhost:8000`
# into the rewrites and every API call and login breaks in production.
# The build itself makes NO request to it: catalogue and FX rates are committed files.
# Use `localhost`, never `127.0.0.1`: allauth builds the Google redirect_uri from the
# forwarded Host, and a session cookie scoped to 127.0.0.1 never reaches the frontend.
BACKEND_ORIGIN=http://localhost:8000

# Stripe publishable key (client-safe; the SECRET key stays on the backend).
# Must be the pk_live_… key when the backend is on sk_live_… — a mismatched pair
# fails at confirmation, after the customer has already committed.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Analytics (optional, consent-gated).
# NEXT_PUBLIC_ANALYTICS_ID=

# Where `npm run catalog` reads from. Needed ONLY when you deliberately refresh the
# committed data — nothing in `next build` calls it.
#
# Two files are committed source, not build output:
#   src/data/catalog.json  — 68 countries, 385 plans
#   src/data/rates.json    — the FX table the currency picker offers
#
# So `next build` needs no backend at all, and a backend that is down cannot silently
# ship a store with no plans or a single-currency site. Refreshing is explicit: run
# `npm run catalog`, read the diff, commit it. Both files are rewritten together so
# prices and the rates that convert them cannot drift apart.
#
# The no-leak check that used to run during the build is enforced independently by
# src/data/catalog.data.test.js, and staleness by src/data/rates.staleness.test.js.
CATALOG_API_ORIGIN=http://localhost:8000
