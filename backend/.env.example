# Template only — every value here stays EMPTY. Real secrets live in .env (gitignored).

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DATABASE_URL=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_DOMAIN=

# Required in production: throttle counters live here, and a per-process backend would
# multiply every rate limit by the worker count. e.g. redis://host:6379/0
CACHE_URL=

FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=
# Optional key ring for rotation. Retired keys stay here as decrypt-only, so raising the
# active version never orphans existing ciphertext: {"1":"<old key>","2":"<new key>"}
FIELD_ENCRYPTION_KEYS_JSON=
ICCID_HMAC_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# stripe | fake. Unknown values are refused at startup rather than silently faked.
PAYMENTS_GATEWAY=

ESIM_SUPPLIER_BASE_URL=
ESIM_SUPPLIER_API_KEY=
ESIM_SUPPLIER_SECRET_KEY=
# esim_access | fake. Defaults to "fake": the supplier has no sandbox, so every real call
# spends wallet money and going live must be a deliberate act, not a side effect of
# holding credentials.
SUPPLIER_GATEWAY=
# Set true only for a deliberately non-selling demo deployment. Production refuses to boot
# on a fake provider otherwise.
ALLOW_FAKE_GATEWAYS=

EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
EMAIL_PROVIDER_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_REDIRECT_URL=
FRONTEND_BASE_URL=
