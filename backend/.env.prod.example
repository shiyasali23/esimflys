# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment — the single place to paste live keys.
#
# Copy this to `.env.prod` (gitignored) and fill the PASTE_ME values, then run:
#
#     ./scripts/sync-prod-env.sh
#
# to push every key to Railway in one go.
#
# THIS TEMPLATE IS COMMITTED. `.env.prod` IS NOT, AND MUST NEVER BE.
# Never put a real value in this file — only in `.env.prod`.
#
# Nothing here goes to Cloudflare. The Worker is a pure proxy: its only binding is
# BACKEND_ORIGIN, a public URL already committed in frontend/wrangler.jsonc. The one
# frontend key (Stripe PUBLISHABLE) is public by design and is baked into the static
# HTML at build time from frontend/.env.local.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=False
# 50+ random chars. Rotating it logs every user out.
DJANGO_SECRET_KEY=PASTE_ME
LOG_LEVEL=INFO

# --- Hosts and origins --------------------------------------------------------
# Django validates the proxied X-Forwarded-Host against this list, so it must stay
# explicit. Never `*`: the Railway origin is publicly reachable, and a wildcard would
# let anyone forge the host Django builds its absolute URLs from.
ALLOWED_HOSTS=esimflys.com,www.esimflys.com,esimflys-production-512c.up.railway.app
CSRF_TRUSTED_ORIGINS=https://esimflys.com,https://www.esimflys.com
CORS_ALLOWED_ORIGINS=https://esimflys.com,https://www.esimflys.com
# Where allauth sends people after login/logout. Must be the apex, not the Railway host.
FRONTEND_BASE_URL=https://esimflys.com

# --- Database -----------------------------------------------------------------
# Railway injects this from the Postgres service. Do NOT set it by hand — leave it
# out of .env.prod entirely and let the service reference provide it.
# DATABASE_URL=<managed by Railway>
DB_CONN_MAX_AGE=60

# --- Session / cookies --------------------------------------------------------
SESSION_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=31536000

# --- Google OAuth -------------------------------------------------------------
# From console.cloud.google.com, OAuth client "esimflys-backend".
# The authorized redirect URI there must be exactly:
#     https://esimflys.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=73583360314-cp9cdc2624rf522ojmtfkkjf02j7p010.apps.googleusercontent.com
# Google no longer lets you view an existing secret. If you did not save it, click
# "Add secret" on that client and paste the new one — the old one keeps working.
GOOGLE_CLIENT_SECRET=PASTE_ME

# --- Stripe (LIVE mode) -------------------------------------------------------
# All three must be from the SAME mode. An sk_live_ paired with a whsec_ from test
# mode fails signature verification on every webhook, silently.
STRIPE_SECRET_KEY=PASTE_ME_sk_live_
STRIPE_WEBHOOK_SECRET=PASTE_ME_whsec_
PAYMENTS_GATEWAY=stripe

# --- eSIM supplier ------------------------------------------------------------
SUPPLIER_GATEWAY=PASTE_ME
ESIM_SUPPLIER_BASE_URL=PASTE_ME
ESIM_SUPPLIER_API_KEY=PASTE_ME
ESIM_SUPPLIER_SECRET_KEY=PASTE_ME

# Guard rail: keeps the fake payment/supplier gateways unreachable in production.
# Never set this True on Railway — it would let orders complete without charging.
ALLOW_FAKE_GATEWAYS=False

# --- Encryption ---------------------------------------------------------------
# Rotating either of these makes existing stored values unreadable. Bump the VERSION
# when you rotate; do not reuse a version number.
FIELD_ENCRYPTION_KEY=PASTE_ME
FIELD_ENCRYPTION_KEY_VERSION=1
ICCID_HMAC_KEY=PASTE_ME

# --- Email --------------------------------------------------------------------
DEFAULT_FROM_EMAIL=eSIMFlys <no-reply@esimflys.com>

# --- FX -----------------------------------------------------------------------
# Mirrored in the frontend. Change one and the displayed price stops matching the
# charged price — see src/config/currencies.js.
FX_RATE_INR=88
FX_BUFFER=1.03
